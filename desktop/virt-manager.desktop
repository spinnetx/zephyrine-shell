[Desktop Entry]
# Локальная копия системного virt-manager.desktop: лаунчер Quickshell ищет только по полю Name,
# а оно локализовано («Менеджер виртуальных машин»), поэтому запрос «virt-manager» ничего не находил.
Name=Virt-Manager (Virtual Machine Manager)
Name[ru]=Virt-Manager (менеджер виртуальных машин)
GenericName=Virtual machine viewer/manager
Comment=Manage virtual machines
Comment[ru]=Управление виртуальными машинами
Icon=virt-manager
Exec=virt-manager
Type=Application
Terminal=false
Categories=System;Emulator;GTK;
Keywords=virtualization;libvirt;vm;vmm;qemu;xen;lxc;kvm;
