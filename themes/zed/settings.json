// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    // "dark", а не "system" — "system" и было причиной "слишком светло":
    // при неверном определении цветовой схемы ОС Zed уезжал в light-вариант.
    "mode": "dark",
    "light": "Zephyrine",
    // Своя тема Zephyrine (themes/zephyrine.json): палитра ObsidianNeon из
    // quickshell/scheme.json, альфа фонов/рамок — по схеме прозрачной One Dark.
    "dark": "Zephyrine"
  }
}
