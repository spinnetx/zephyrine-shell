# Экран блокировки Zephyrine: SUPER+L и hypridle (lock_cmd) запускают scripts/lock-with-video.sh — он поднимает
# видео-обои mpvpaper на слое overlay и затем hyprlock. Фон hyprlock здесь ПРОЗРАЧНЫЙ (alpha 0): видео
# видно сквозь него благодаря misc.session_lock_xray = true в hyprland.lua (приём из
# github.com/Jack02134x/hyprlock-mp4-guide). Картинку/размытие фона НЕ добавлять — иначе видео пропадёт.
# Размытие «при вводе пароля» у hyprlock невозможно: нет ни события набора текста, ни динамического blur.
#
# Вид — в языке дизайна бара Quickshell и темы SDDM: сверху плавающая пилюля (дата/время слева,
# раскладка и батарея справа), по центру карточка с аватаром, именем и полем пароля.
# Координаты рассчитаны на монитор 1920x1080 (все виджеты привязаны к центру экрана, y вверх — плюс).
# Тексты для виджетов даёт scripts/lock-info.sh (date | battery | name).
#
# Файл СГЕНЕРИРОВАН zephyrine-settings из templates/hypr/hyprlock.conf.tmpl — руками не править (правки уйдут при следующем применении).
# Цвета берутся из эффективной палитры центра настроек (акцент — appearance.accent), шрифт — appearance.fonts.lock.family.
# Роли: surfaceContainerHigh — пилюля/карточка (alpha 0.85/0.86); surfaceContainerHighest — поле ввода, малые пилюли;
# outlineVariant — тонкие рамки (alpha 0.5); onSurface — основной текст; onSurfaceVariant — вторичный текст; primary — акцент;
# primaryContainer — ореол крупных часов; tertiary — проверка пароля / Caps Lock; error — ошибка.

general {
    hide_cursor = true
}

animations {
    enabled = true
    bezier = easeOut, 0.2, 0.8, 0.2, 1.0
    animation = fadeIn, 1, 4, easeOut
    animation = fadeOut, 1, 4, easeOut
    animation = inputFieldColors, 1, 4, easeOut
    animation = inputFieldDots, 1, 3, easeOut
}

background {
    monitor =
    color = rgba(0, 0, 0, 0)
    blur_passes = 0
}

# ---------- Верхняя пилюля: отступ 6 от краёв, высота 40, радиус 14 (как у бара) ----------
# Центр пилюли по y: 540 - (6 + 20) = 514 от центра экрана.
shape {
    monitor =
    size = 1908, 40
    color = {{ c.surfaceContainerHigh | rgba:0.85 }}
    rounding = 14
    border_size = 1
    border_color = {{ c.outlineVariant | rgba:0.5 }}
    position = 0, 514
    halign = center
    valign = center
}

# Время (слева, акцентом) и дата (вторичным цветом)
label {
    monitor =
    text = $TIME
    font_size = 16
    font_family = {{ f.lock.family }} Bold
    color = {{ c.primary | rgba:1.0 }}
    position = -914, 514
    halign = center
    valign = center
}
label {
    monitor =
    text = cmd[update:60000] lock-info.sh date
    font_size = 12
    font_family = {{ f.lock.family }}
    color = {{ c.onSurfaceVariant | rgba:1.0 }}
    text_align = left
    position = -740, 514
    halign = center
    valign = center
}

# Батарея: малая пилюля 96x28, правый край на 8 px левее края пилюли
shape {
    monitor =
    size = 96, 28
    color = {{ c.surfaceContainerHighest | rgba:0.9 }}
    rounding = 10
    border_size = 1
    border_color = {{ c.outlineVariant | rgba:0.5 }}
    position = 898, 514
    halign = center
    valign = center
}
label {
    monitor =
    text = cmd[update:30000] lock-info.sh battery
    font_size = 11
    font_family = {{ f.lock.family }}
    color = {{ c.onSurface | rgba:1.0 }}
    position = 898, 514
    halign = center
    valign = center
}

# Раскладка клавиатуры (индексы соответствуют input.kb_layout = "pl,ru" в hyprland.lua): малая пилюля 56x28
shape {
    monitor =
    size = 56, 28
    color = {{ c.surfaceContainerHighest | rgba:0.9 }}
    rounding = 10
    border_size = 1
    border_color = {{ c.outlineVariant | rgba:0.5 }}
    position = 814, 514
    halign = center
    valign = center
}
label {
    monitor =
    text = $LAYOUT[PL,RU]
    font_size = 11
    font_family = {{ f.lock.family }} Bold
    color = {{ c.primary | rgba:1.0 }}
    position = 814, 514
    halign = center
    valign = center
}

# ---------- Крупные часы над карточкой ----------
# Контур вокруг каждого символа: hyprlock не умеет обводку (stroke) шрифта, но у label есть
# плотная тень без смещения — по краям букв получается ореол. Цвет — primaryContainer темы ({{ c.primaryContainer | hex }}).
label {
    monitor =
    text = $TIME
    font_size = 96
    font_family = {{ f.lock.family }} Bold
    color = {{ c.onSurface | rgba:1.0 }}
    shadow_passes = 3
    shadow_size = 4
    shadow_color = {{ c.primaryContainer | rgba:1.0 }}
    shadow_boost = 1.5
    position = 0, 250
    halign = center
    valign = center
}

# ---------- Центральная карточка 460x330, радиус 18; центр на 30 ниже центра экрана ----------
# Карточка занимает y от +135 до -195.
shape {
    monitor =
    size = 460, 330
    color = {{ c.surfaceContainerHigh | rgba:0.86 }}
    rounding = 18
    border_size = 1
    border_color = {{ c.outlineVariant | rgba:0.5 }}
    position = 0, -30
    halign = center
    valign = center
}

# Круглый аватар 96 с рамкой primary (rounding = -1 — круг)
image {
    monitor =
    path = ~/.face
    size = 96
    rounding = -1
    border_size = 2
    border_color = {{ c.primary | rgba:1.0 }}
    position = 0, 60
    halign = center
    valign = center
}

# Имя пользователя
label {
    monitor =
    text = cmd[update:3600000] lock-info.sh name
    font_size = 15
    font_family = {{ f.lock.family }} Bold
    color = {{ c.onSurface | rgba:1.0 }}
    position = 0, -12
    halign = center
    valign = center
}

# Поле пароля в стиле Field.qml SDDM-темы: скруглённое, рамка primary, ошибка встроена в поле
input-field {
    monitor =
    size = 400, 50
    rounding = 14
    outline_thickness = 2
    outer_color = {{ c.primary | rgba:1.0 }}
    inner_color = {{ c.surfaceContainerHighest | rgba:0.9 }}
    font_color = {{ c.onSurface | rgba:1.0 }}
    font_family = {{ f.lock.family }}
    check_color = {{ c.tertiary | rgba:1.0 }}
    fail_color = {{ c.error | rgba:1.0 }}
    # Подсветка поля, когда включён Caps Lock — отдельного текстового индикатора
    # у hyprlock нет, это штатный механизм (см. https://wiki.hypr.land/Hypr-Ecosystem/hyprlock/)
    capslock_color = {{ c.tertiary | rgba:1.0 }}
    swap_font_color = false
    hide_input = false
    dots_size = 0.25
    dots_spacing = 0.3
    dots_center = true
    dots_rounding = -1
    fade_on_empty = false
    placeholder_text = <i>Пароль</i>
    fail_text = <i>$FAIL · попыток: $ATTEMPTS</i>
    position = 0, -78
    halign = center
    valign = center
}

# Подсказка под полем
label {
    monitor =
    text = Введите пароль, чтобы разблокировать
    font_size = 10
    font_family = {{ f.lock.family }}
    color = {{ c.onSurfaceVariant | rgba:1.0 }}
    position = 0, -140
    halign = center
    valign = center
}
