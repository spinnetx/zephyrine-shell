                    }
                },
                {
                    "type": "ini",
                    "section": "Settings",
                    "key": "gtk-theme-name",
                    "from": "appearance.mode",
                    "map": {
                        "dark": "adw-gtk3-dark",
                        "light": "adw-gtk3"
                    }
                },
                {
                    "type": "ini",
                    "section": "Settings",
                    "key": "gtk-icon-theme-name",
                    "from": "appearance.icons.theme",
                    "fallback": {
