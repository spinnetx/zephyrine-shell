            },
            "manageKey": "appearance.targets.zen-content"
        },
        {
            "id": "gtk3-settings",
            "kind": "patch",
            "stage": "v1.1",
            "template": null,
            "output": ".config/gtk-3.0/settings.ini",
            "deploy": "copy:~/.config/gtk-3.0/settings.ini",
            "reload": "none",
            "restart": "GTK 3 - перезапуск приложений",
            "detect": {
                "type": "always"
            },
            "keys": [
                "appearance.fonts.ui.family",
                "appearance.fonts.ui.size",
                "appearance.mode",
                "appearance.icons.theme",
                "appearance.cursor.theme",
                "appearance.cursor.size"
            ],
            "golden": false,
            "patches": [
                {
                    "type": "ini",
                    "section": "Settings",
                    "key": "gtk-font-name",
                    "from": "appearance.fonts.ui",
                    "value": "{family},  {size}"
                },
                {
                    "type": "ini",
                    "section": "Settings",
                    "key": "gtk-application-prefer-dark-theme",
                    "from": "appearance.mode",
                    "map": {
                        "dark": "true",
                        "light": "false"
                    }
                },
                {
                    "type": "ini",
                    "section": "Settings",
                    "key": "gtk-theme-name",
                    "from": "appearance.mode",
                    "map": {
                        "dark": "adw-gtk3-dark",
                        "light": "adw-gtk3"
                    }
                },
                {
                    "type": "ini",
                    "section": "Settings",
                    "key": "gtk-icon-theme-name",
                    "from": "appearance.icons.theme",
                    "fallback": {
                        "from": "appearance.mode",
                        "map": {
                            "dark": "Papirus-Dark",
                            "light": "Papirus"
                        }
                    }
                },
                {
                    "type": "ini",
                    "section": "Settings",
                    "key": "gtk-cursor-theme-name",
                    "from": "appearance.cursor.theme"
                },
                {
                    "type": "ini",
                    "section": "Settings",
                    "key": "gtk-cursor-theme-size",
                    "from": "appearance.cursor.size"
                }
            ],
            "manageKey": "appearance.targets.gtk3-settings",
            "notes": "Правятся gtk-font-name и (по режиму темы) gtk-application-prefer-dark-theme, gtk-theme-name, gtk-icon-theme-name (appearance.icons.theme, null = по режиму), gtk-cursor-theme-name, gtk-cursor-theme-size; остальные ключи settings.ini не трогаются. Формат значения как в файле: 'Inter,  10'."
        },
        {
            "id": "gtk4-settings",
            "kind": "patch",
            "stage": "v1.1",
            "template": null,
            "output": ".config/gtk-4.0/settings.ini",
