            "targets": [
                "hypr"
            ],
            "live": false,
            "stage": "v1",
            "doc": "Рамки окон: legacy = текущий градиент 33ccffee->00ff99ee 45deg, неактивная 595959aa; accent = primary->secondary (ee), неактивная outlineVariant (aa); custom = hypr.borders.custom."
        },
        "hypr.borders.size": {
            "type": "integer",
            "default": 2,
            "min": 0,
            "max": 4,
            "step": 1,
            "unit": "px",
            "targets": [
                "hypr"
            ],
            "live": false,
            "stage": "v1",
            "doc": "Толщина рамки (general.border_size)."
        },
        "hypr.borders.custom": {
            "type": "object",
            "default": {
                "active": [
                    "rgba(33ccffee)",
                    "rgba(00ff99ee)"
                ],
                "angle": 45,
                "inactive": "rgba(595959aa)"
            },
            "items": {
                "active": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^rgba\\([0-9a-fA-F]{8}\\)$"
                    },
                    "minItems": 1
                },
                "angle": {
                    "type": "integer",
                    "min": 0,
                    "max": 360
                },
                "inactive": {
                    "type": "string",
                    "pattern": "^rgba\\([0-9a-fA-F]{8}\\)$"
                }
            },
            "targets": [
                "hypr"
            ],
            "live": false,
            "stage": "v1",
            "doc": "Свои рамки (при style=custom): active - 1..n цветов rgba(rrggbbaa), angle 0..360, inactive - один цвет."
        },
        "hypr.glassOpacity": {
            "type": "number",
            "default": 0.7,
