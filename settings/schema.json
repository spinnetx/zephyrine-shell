        "appearance.targets.*": {
            "type": "boolean",
            "default": true,
            "pattern": "appearance.targets.<id>",
            "targets": [],
            "live": false,
            "stage": "v1",
            "doc": "Управлять целью (по id из targets.json). false = цель не перегенерируется. Шаблонный ключ: подставляется id цели."
        },
        "hypr.borders.style": {
            "type": "enum",
