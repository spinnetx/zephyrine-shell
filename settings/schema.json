                "zen-chrome"
            ],
            "live": true,
            "stage": "v1",
            "doc": "Базовое скругление: lg=r+2, md=r, sm=max(0,r-2), xs=max(0,r-4); бар: pillRadius=r, barRadius/popoutRadius=r+2."
        },
        "appearance.windowRounding": {
            "type": "integer",
            "default": 10,
