{
    "version": 1,
    "description": "Схема настроек Zephyrine (DESIGN §5). keys - плоский словарь 'ключ с точками -> описание'. Эффективное значение = settings.json (только отличия) + default. Ключи со '*' - шаблонные (pattern). stub:true - заглушка будущего этапа, значения валидируются, но не применяются.",
    "fields": "type (number|integer|boolean|string|color|enum|font|path|array|object), default, min/max/step, enum, nullable, pattern, presets, items, enumSource, fontFilter, relativeTo, unit, targets (id целей из targets.json для перегенерации при set), live (бар показывает превью через Prefs.preview), stage (v1|v1.1|2|3|4), stub, doc.",
    "stages": [
        "v1",
        "v1.1",
        "2",
        "3",
        "4"
    ],
    "keys": {
        "appearance.accent": {
            "type": "color",
            "default": null,
            "nullable": true,
            "pattern": "^#[0-9a-fA-F]{6}$",
            "presets": {
                "purple": "#bb9af7",
                "blue": "#7aa2f7",
                "cyan": "#2ac3de",
                "green": "#9ece6a",
                "yellow": "#e0af68",
                "orange": "#ff9e64",
                "red": "#f7768e",
                "pink": "#f5a3d4"
            },
            "targets": [
                "quickshell",
                "gtk3",
                "gtk4",
                "qt6ct",
                "kitty",
                "zathura",
                "obsidian",
                "tb-css",
                "tb-theme",
                "zen-chrome",
                "zen-content",
                "hypr",
                "hyprlock",
                "sddm"
            ],
            "live": false,
            "stage": "v1",
            "doc": "Акцент (primary). null = primary из scheme.json. Контраст к background >= 3:1, OKLCH L >= 0.55."
        },
        "appearance.mode": {
            "type": "enum",
            "enum": [
                "dark",
                "light"
            ],
            "default": "dark",
            "targets": [
                "quickshell",
                "hypr",
                "gtk3",
                "gtk4",
                "qt6ct",
                "zed",
                "kitty",
                "zathura",
                "obsidian",
                "tb-css",
                "tb-theme",
                "zen-chrome",
                "zen-content",
                "gtk3-settings",
                "gtk4-settings",
                "qt6ct-conf",
                "gsettings",
                "hyprlock",
                "sddm"
            ],
            "live": false,
            "stage": "v1.1",
            "doc": "Тема: тёмная или светлая. Светлая палитра - palette-roles.json schemes.light (tools/make_light_palette.py); акцент в светлой теме автоматически приводится к допустимой светлоте."
        },
        "appearance.glassAlpha": {
            "type": "number",
            "default": 0.88,
            "min": 0.5,
            "max": 1.0,
            "step": 0.01,
            "targets": [
                "gtk3",
                "gtk4",
                "obsidian",
                "tb-css",
                "zen-chrome",
                "zed"
            ],
            "live": true,
            "stage": "v1",
            "doc": "Альфа стекла (фон окон/бара)."
        },
        "appearance.surfaceAlpha": {
            "type": "number",
            "default": 0.94,
            "min": 0.7,
            "max": 1.0,
            "step": 0.01,
            "targets": [
                "gtk3",
                "gtk4",
                "obsidian",
                "tb-css"
            ],
            "live": true,
            "stage": "v1",
            "doc": "Плотность элементов (пилюли, контейнеры)."
        },
        "appearance.radius": {
            "type": "integer",
            "default": 12,
            "min": 0,
            "max": 20,
            "step": 1,
