#!/usr/bin/env bash
#
# zephyrine-session — Отказоустойчивая точка входа сессии Zephyrine (Hyprland + Quickshell)
# Гарантированно работает на любом оборудовании: Intel, AMD, NVIDIA, multi-GPU и виртуальных машинах.
#

set -euo pipefail

# 1. Логирование сессии
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/zephyrine"
mkdir -p "$LOG_DIR" 2>/dev/null || true
exec >> "${LOG_DIR}/session.log" 2>&1
echo "=================================================="
echo "=== Zephyrine Session started at $(date) ==="
echo "=================================================="

# 2. Базовые переменные окружения Wayland
export XDG_CURRENT_DESKTOP="Hyprland"
export XDG_SESSION_DESKTOP="Hyprland"
export XDG_SESSION_TYPE="wayland"

# 3. Определение каталогов Zephyrine
if [ -z "${ZEPHYRINE_DIR:-}" ]; then
    if [ -d "/usr/share/zephyrine" ]; then
        export ZEPHYRINE_DIR="/usr/share/zephyrine"
    elif [ -d "${HOME}/.local/share/zephyrine" ]; then
        export ZEPHYRINE_DIR="${HOME}/.local/share/zephyrine"
    else
        SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
        export ZEPHYRINE_DIR="$SELF_DIR"
    fi
fi

export ZEPHYRINE_QS_DIR="${ZEPHYRINE_QS_DIR:-${ZEPHYRINE_DIR}/quickshell}"
export ZEPHYRINE_DEFAULT_WALLPAPER="${ZEPHYRINE_DEFAULT_WALLPAPER:-${ZEPHYRINE_DIR}/assets/wallpapers/japanese-night-village.1920x1080.mp4}"
export PATH="/usr/lib/zephyrine/scripts:${HOME}/.local/bin:${ZEPHYRINE_DIR}/bin:${ZEPHYRINE_DIR}/scripts:$PATH"

# 4. Симлинк quickshell конфигурации для пользователя
USER_QS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/zephyrine"
if [ ! -e "$USER_QS_DIR" ] && [ -d "$ZEPHYRINE_QS_DIR" ]; then
    mkdir -p "$(dirname "$USER_QS_DIR")" 2>/dev/null || true
    ln -s "$ZEPHYRINE_QS_DIR" "$USER_QS_DIR" 2>/dev/null || true
fi
if [ -e "$USER_QS_DIR" ]; then
    export ZEPHYRINE_QS_DIR="$USER_QS_DIR"
fi

# 5. Аппаратное ускорение NVIDIA (активируется ТОЛЬКО если в ядре активен драйвер nvidia)
if [ -e "/dev/nvidiactl" ] || [ -d "/proc/driver/nvidia" ]; then
    echo "==> Обнаружен драйвер NVIDIA: активация переменных аппаратного ускорения"
    export LIBVA_DRIVER_NAME="${LIBVA_DRIVER_NAME:-nvidia}"
    export __GLX_VENDOR_LIBRARY_NAME="${__GLX_VENDOR_LIBRARY_NAME:-nvidia}"
    export NVD_BACKEND="${NVD_BACKEND:-direct}"
fi

# 6. Подготовка и санитизация конфигурации Hyprland
USER_HYPR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
USER_HYPR_CONF="${USER_HYPR_DIR}/hyprland.lua"
SYS_HYPR_CONF="${ZEPHYRINE_DIR}/hypr/hyprland.lua"

mkdir -p "$USER_HYPR_DIR" 2>/dev/null || true

# Вспомогательные конфигурации демонов
for f in hypridle.conf hyprlock.conf; do
    if [ ! -f "${USER_HYPR_DIR}/${f}" ] && [ -f "${ZEPHYRINE_DIR}/hypr/${f}" ]; then
        cp "${ZEPHYRINE_DIR}/hypr/${f}" "${USER_HYPR_DIR}/${f}" 2>/dev/null || true
    fi
done

# Проверка и санитизация пользовательского конфига
TARGET_CONF=""

if [ -f "$USER_HYPR_CONF" ]; then
    # Если в пользовательском конфиге обнаружены устаревшие фатальные директивы Mesa/WLR
    if grep -q "__EGL_VENDOR_LIBRARY_FILENAMES" "$USER_HYPR_CONF" 2>/dev/null || \
       grep -q "WLR_DRM_DEVICES" "$USER_HYPR_CONF" 2>/dev/null; then
        echo "==> [ВНИМАНИЕ] Обнаружены устаревшие несовместимые параметры EGL/DRM в $USER_HYPR_CONF"
        echo "==> Автоматическое устранение устаревших строк..."
        cp "$USER_HYPR_CONF" "${USER_HYPR_CONF}.bak-deprecated-$(date +%s)" 2>/dev/null || true
        sed -i '/__EGL_VENDOR_LIBRARY_FILENAMES/d' "$USER_HYPR_CONF" 2>/dev/null || true
        sed -i '/__GLX_VENDOR_LIBRARY_NAME.*mesa/d' "$USER_HYPR_CONF" 2>/dev/null || true
        sed -i '/WLR_DRM_DEVICES/d' "$USER_HYPR_CONF" 2>/dev/null || true
    fi

    # Проверяем валидность пользовательского конфига встроенным валидатором Hyprland
    if Hyprland --config "$USER_HYPR_CONF" --verify-config >/dev/null 2>&1; then
        TARGET_CONF="$USER_HYPR_CONF"
        echo "==> Пользовательский конфиг $USER_HYPR_CONF проверен и валиден."
    else
        echo "==> [ОШИБКА] Пользовательский конфиг $USER_HYPR_CONF не прошел валидацию Hyprland!"
        echo "==> Аварийное переключение на системный эталонный конфиг $SYS_HYPR_CONF"
        cp "$USER_HYPR_CONF" "${USER_HYPR_CONF}.broken-$(date +%s)" 2>/dev/null || true
        if [ -f "$SYS_HYPR_CONF" ]; then
            cp "$SYS_HYPR_CONF" "$USER_HYPR_CONF" 2>/dev/null || true
            TARGET_CONF="$USER_HYPR_CONF"
        fi
    fi
elif [ -f "$SYS_HYPR_CONF" ]; then
    echo "==> Инициализация пользовательского конфига из системного $SYS_HYPR_CONF..."
    cp "$SYS_HYPR_CONF" "$USER_HYPR_CONF" 2>/dev/null || true
    TARGET_CONF="$USER_HYPR_CONF"
fi

if [ -z "$TARGET_CONF" ] && [ -f "$SYS_HYPR_CONF" ]; then
    TARGET_CONF="$SYS_HYPR_CONF"
fi

CONF_ARG=()
if [ -n "$TARGET_CONF" ]; then
    CONF_ARG=("--config" "$TARGET_CONF")
fi

echo "==> Запуск композитора Hyprland..."
echo "    ZEPHYRINE_DIR: $ZEPHYRINE_DIR"
echo "    ZEPHYRINE_QS_DIR: $ZEPHYRINE_QS_DIR"
echo "    CONFIG: ${TARGET_CONF:-default}"

cleanup_session() {
    echo "==> Завершение сессии Zephyrine: очистка переменных окружения systemd..."
    systemctl --user unset-environment \
        WAYLAND_DISPLAY \
        XDG_CURRENT_DESKTOP \
        XDG_SESSION_DESKTOP \
        XDG_SESSION_TYPE \
        HYPRLAND_CMD \
        HYPRLAND_INSTANCE_SIGNATURE \
        AQ_DRM_DEVICES \
        LIBVA_DRIVER_NAME \
        __GLX_VENDOR_LIBRARY_NAME \
        NVD_BACKEND \
        QT_QPA_PLATFORMTHEME \
        ZEPHYRINE_DIR \
        ZEPHYRINE_QS_DIR \
        ZEPHYRINE_DEFAULT_WALLPAPER \
        2>/dev/null || true
    echo "==> Сессия завершена."
}
trap cleanup_session EXIT

# 7. Запуск официальной точки входа (start-hyprland с watchdog или напрямую Hyprland)
EXIT_CODE=0
if command -v start-hyprland >/dev/null 2>&1; then
    start-hyprland -- "${CONF_ARG[@]}" || EXIT_CODE=$?
elif command -v Hyprland >/dev/null 2>&1; then
    Hyprland "${CONF_ARG[@]}" || EXIT_CODE=$?
elif command -v hyprland >/dev/null 2>&1; then
    hyprland "${CONF_ARG[@]}" || EXIT_CODE=$?
else
    echo "CRITICAL: Ни один бинарник Hyprland не найден в PATH!" >&2
    exit 1
fi

exit "$EXIT_CODE"
