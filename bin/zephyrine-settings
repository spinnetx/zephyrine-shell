#!/usr/bin/env bash
#
# zephyrine-settings — CLI Центра Настроек оболочки Zephyrine

set -euo pipefail

# Определение каталога настроек
if [ -z "${ZEPHYRINE_SETTINGS_DIR:-}" ]; then
    if [ -d "/usr/share/zephyrine/settings" ]; then
        SETTINGS_DIR="/usr/share/zephyrine/settings"
    elif [ -d "${HOME}/.local/share/zephyrine/settings" ]; then
        SETTINGS_DIR="${HOME}/.local/share/zephyrine/settings"
    else
        SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
        SETTINGS_DIR="${SELF_DIR}/settings"
    fi
else
    SETTINGS_DIR="$ZEPHYRINE_SETTINGS_DIR"
fi

export PYTHONPATH="${SETTINGS_DIR}${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m zsettings "$@"
